# --- Google Sheets service account (server-only, never exposed to the client) ---
# Service account email, e.g. ira-dashboard@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The service account's private key, PEM format. Paste it with literal \n for newlines
# (that's how Vercel's env var UI stores multi-line secrets), e.g.:
# "-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# The spreadsheet ID from the sheet's URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Tab names as they literally appear on the sheet (defaults match the real "IRA ARR" sheet).
# GOOGLE_SHEET_DAILY_TAB=Sheet 1
# GOOGLE_SHEET_INTRADAY_TAB=Intraday10min

# How many days old the data can be before the freshness indicator turns amber.
# STALE_THRESHOLD_DAYS=2

# --- Shared-password gate ---
# The password visitors type in at /login.
DASHBOARD_PASSWORD=
# Random secret used to sign session cookies. Generate with: openssl rand -base64 32
DASHBOARD_SESSION_SECRET=
