# Copy to .env in this folder. Never commit the real .env — it holds a Metabase API key and a
# Google service account private key, both of which grant real write/read access.

# Metabase (metabase.prod.rumik.ai) API key, read-only role. Requires the Rumik VPN to reach it.
MB_KEY=

# Same service account already used by the Next.js dashboard's GOOGLE_SERVICE_ACCOUNT_* vars —
# share the "IRA ARR" spreadsheet with this account's email as Editor (the dashboard only needs
# Viewer; this backend needs Editor since it writes rows).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The spreadsheet ID from its URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
